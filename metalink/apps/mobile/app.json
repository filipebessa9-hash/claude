{
  "expo": {
    "name": "MetaLink",
    "slug": "metalink",
    "scheme": "metalink",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.metalink.app"
    },
    "android": {
      "package": "br.com.metalink.app"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
